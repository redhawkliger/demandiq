{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "demandiq:project (localStorage snapshot) — Examiner puzzle subset",
  "description": "Derived by hand from frontend/src/store/projectStore.js (snapshot shape, defaultApproach, ensureBalancingDefaults, link shape) and frontend/src/sessions/S6_RunAnalysis.jsx buildPayload (which fields the balance pipeline actually consumes). Frozen at frontend git SHA 96968a35; harness/schema/check_drift.py re-checks the source markers in CI so silent frontend drift breaks the build, not the harness's honesty. lanes.minItems is 0, not 1: S3_ApproachConfig.jsx toggleDne() persists lanes: [] on an exists:false leg, so a real 3-leg project has an empty lanes array on the dropped approach.",
  "type": "object",
  "required": ["project", "analysis", "intersections", "links", "balancing"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "client": {"type": "string"},
        "projectNumber": {"type": "string"},
        "analyst": {"type": "string"},
        "checker": {"type": "string"},
        "date": {"type": "string"},
        "scenario": {"type": "string"},
        "projectType": {"type": "string"},
        "analysisPeriods": {"type": "array", "items": {"enum": ["AM", "PM"]}}
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "corridorDir": {"enum": ["EW", "NS"]}
      }
    },
    "intersections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "num", "name", "lat", "lng", "approaches", "volumes"],
        "properties": {
          "id": {"type": "string"},
          "num": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "lat": {"type": "number"},
          "lng": {"type": "number"},
          "approaches": {
            "type": "object",
            "required": ["EB", "WB", "NB", "SB"],
            "properties": {
              "EB": {"$ref": "#/$defs/approach"},
              "WB": {"$ref": "#/$defs/approach"},
              "NB": {"$ref": "#/$defs/approach"},
              "SB": {"$ref": "#/$defs/approach"}
            }
          },
          "volumes": {
            "type": "object",
            "properties": {
              "AM": {"$ref": "#/$defs/periodVolumes"},
              "PM": {"$ref": "#/$defs/periodVolumes"}
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fromId", "toId", "direction", "mode"],
        "properties": {
          "id": {"type": "string"},
          "fromId": {"type": "string"},
          "toId": {"type": "string"},
          "direction": {"enum": ["EB/WB", "NB/SB"]},
          "mode": {"enum": ["Full", "Land Use", "None"]},
          "landUseThreshold": {"type": ["number", "null"]}
        }
      }
    },
    "balancing": {
      "type": "object",
      "required": ["linkResolution", "corridorDir", "convergenceThreshold", "maxIterations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "linkResolution": {"enum": ["larger", "average"]},
        "corridorDir": {"enum": ["EB/WB", "NB/SB"]},
        "peakMode": {"enum": ["Corridor", "Independent"]},
        "amWindow": {"$ref": "#/$defs/window"},
        "pmWindow": {"$ref": "#/$defs/window"},
        "convergenceThreshold": {"type": "number", "minimum": 0},
        "maxIterations": {"type": "integer", "minimum": 1},
        "linkBalanceModes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/linkMode"}
        },
        "overrides": {
          "type": "object",
          "properties": {"AM": {"type": "object"}, "PM": {"type": "object"}}
        }
      }
    }
  },
  "$defs": {
    "approach": {
      "type": "object",
      "required": ["exists", "lanes", "stopControlled"],
      "properties": {
        "exists": {"type": "boolean"},
        "stopControlled": {"type": "boolean"},
        "lanes": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["movement"],
            "properties": {"movement": {"enum": ["L", "T", "R", "U"]}}
          }
        }
      }
    },
    "periodVolumes": {
      "type": "object",
      "propertyNames": {"pattern": "^(EB|WB|NB|SB)(L|T|R|U)$"},
      "additionalProperties": {"$ref": "#/$defs/volumeCell"}
    },
    "volumeCell": {
      "type": "object",
      "required": ["value", "_source"],
      "properties": {
        "value": {"type": "integer", "minimum": 0},
        "_source": {"enum": ["manual", "agent"]}
      }
    },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
    },
    "linkMode": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["Full", "Land Use", "None"]},
        "threshold": {"type": ["number", "null"]}
      }
    }
  }
}
